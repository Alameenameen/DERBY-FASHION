   </table>

 <!-- Updated Order Summary Section -->
<div class="total-section">
    <div class="total-row">
        <span>Subtotal:</span>
        <span>₹<%= totals.originalSubtotal.toFixed(2) %></span>
    </div>
    
    <% if (order.couponApplied && order.couponDetails) { %>
        <div class="total-row discount">
            <span>Coupon Applied (<%= order.couponDetails.couponName %>):</span>
            <span>-₹<%= (order.couponDetails.discountAmount || 0).toFixed(2) %></span>
        </div>
    <% } %>
    
    <div class="total-row">
        <span>Shipping Charge:</span>
        <span>₹<%= totals.shippingCharge.toFixed(2) %></span>
    </div>
    
    <div class="total-row grand-total">
        <span>Amount Paid:</span>
        <span>₹<%= order.finalAmount.toFixed(2) %></span>
    </div>
    
    <% if (totals.isFullyReturnedOrCancelled && isOnlineOrWalletPayment) { %>
        <div class="total-row text-success">
            <span>Refunded Amount:</span>
            <span>₹<%= totals.refundedAmount.toFixed(2) %></span>
        </div>
    <% } else if (isOnlineOrWalletPayment && totals.refundedAmount > 0) { %>
        <div class="total-row text-success">
            <span>Refunded Amount:</span>
            <span>₹<%= totals.refundedAmount.toFixed(2) %></span>
        </div>
    <% } %>
    
</div>

    <h2>Shipping Address</h2>
    <p>
        <strong>Name:</strong> <%= order.address.name %><br>
        <strong>Street:</strong> <%= order.address.street %><br>
        <strong>City:</strong> <%= order.address.city %><br>
        <strong>State & Pin:</strong> <%= order.address.state %> - <%= order.address.zipCode %><br>
        <strong>Phone:</strong> <%= order.address.phone %>
    </p>

   

    <div>
        <% if (order.status === 'cancelled') { %>
            <div class="order-cancelled-message">
                <h2>Order Cancelled</h2>
                <p>Your order has been successfully cancelled.</p>
                <a href="/" class="btn">OK</a>
            </div>
        <% } else if (order.status === 'delivered') { %>
            <button class="btn return-btn" data-order-id="<%= order._id %>">Return Order</button>
    
            <!-- Return Reason Modal -->
            <div class="modal fade" id="returnReasonModal" tabindex="-1" aria-labelledby="returnReasonModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="returnReasonModalLabel">Return Order</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form id="returnReasonForm">
                                <div class="mb-3">
                                    <label for="returnReason" class="form-label">Reason for Return</label>
                                    <select class="form-select" id="returnReason" required>
                                        <option value="">Select a reason</option>
                                        <option value="Wrong Size">Wrong Size</option>
                                        <option value="Damaged Product">Damaged Product</option>
                                        <option value="Not as Described">Not as Described</option>
                                        <option value="Changed Mind">Changed Mind</option>
                                        <option value="Quality Issue">Quality Issue</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                                <div id="otherReasonContainer" style="display:none;">
                                    <label for="otherReason" class="form-label">Please specify your reason</label>
                                    <textarea class="form-control" id="otherReason" rows="3"></textarea>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-primary" id="submitReturnBtn">Submit Return Request</button>
                        </div>
                    </div>
                </div>
            </div>
        <% } else if (order.status !== 'delivered') { %>
            <button class="btn cancel-btn" data-order-id="<%= order._id %>">Cancel Order</button>
        <% } %>
    </div>

    <div class="modal fade" id="returnItemModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Return Item</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="returnItemForm">
                        <div class="mb-3">
                            <label for="itemReturnReason" class="form-label">Reason for Return</label>
                            <select class="form-select" id="itemReturnReason" required>
                                <option value="">Select a reason</option>
                                <option value="Wrong Size">Wrong Size</option>
                                <option value="Damaged Product">Damaged Product</option>
                                <option value="Not as Described">Not as Described</option>
                                <option value="Changed Mind">Changed Mind</option>
                                <option value="Quality Issue">Quality Issue</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div id="otherItemReasonContainer" style="display:none;">
                            <label for="otherItemReason" class="form-label">Please specify</label>
                            <textarea class="form-control" id="otherItemReason" rows="3"></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="submitItemReturnBtn">Submit</button>
                </div>
            </div>
        </div>
    </div>

</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <!-- Add JavaScript for handling item actions -->
    <script>


   

    document.addEventListener('DOMContentLoaded', function() {
        // Handle Cancel Item
        document.querySelectorAll('.cancel-item-btn').forEach(button => {
            button.addEventListener('click', async function() {
                const orderId = this.getAttribute('data-order-id');
                const itemId = this.getAttribute('data-item-id');
                
                const result = await Swal.fire({
                    title: 'Cancel Item?',
                    text: 'Are you sure you want to cancel this item?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, cancel it',
                    cancelButtonText: 'No, keep it'
                });
    
                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/cancel-order-item/${orderId}/${itemId}`, {
                            method: 'POST'
                        });
                        const data = await response.json();
    
                        if (data.success) {
                            Swal.fire('Cancelled!', 'Item has been cancelled.', 'success')
                                .then(() => window.location.reload());
                        } else {
                            Swal.fire('Error!', data.error || 'Failed to cancel item.', 'error');
                        }
                    } catch (error) {
                        Swal.fire('Error!', 'An unexpected error occurred.', 'error');
                    }
                }
            });
        });

    })
    
        document.addEventListener('DOMContentLoaded', function() {
    let currentItemId = null;
    let currentOrderId = null;

    document.querySelectorAll('.return-item-btn').forEach(button => {
        button.addEventListener('click', function() {
            currentOrderId = this.getAttribute('data-order-id');
            currentItemId = this.getAttribute('data-item-id');
            const returnItemModal = new bootstrap.Modal(document.getElementById('returnItemModal'));
            returnItemModal.show();
        });
    });

    // Handle return reason selection
    const itemReturnReason = document.getElementById('itemReturnReason');
    const otherItemReasonContainer = document.getElementById('otherItemReasonContainer');

    if (itemReturnReason) {
        itemReturnReason.addEventListener('change', function() {
            otherItemReasonContainer.style.display =
                this.value === 'Other' ? 'block' : 'none';
        });
    }

    // Handle return submission
    const submitItemReturnBtn = document.getElementById('submitItemReturnBtn');
    if (submitItemReturnBtn) {
        submitItemReturnBtn.addEventListener('click', async function() {
            if (!currentOrderId || !currentItemId) {
                Swal.fire('Error', 'Invalid order or item', 'error');
                return;
            }

            const returnReason = itemReturnReason.value;
            const otherReason = document.getElementById('otherItemReason').value;

            if (!returnReason) {
                Swal.fire('Error', 'Please select a return reason', 'error');
                return;
            }

            if (returnReason === 'Other' && !otherReason.trim()) {
                Swal.fire('Error', 'Please provide details for "Other" reason', 'error');
                return;
            }

            try {
                const response = await fetch(`/return-order-item/${currentOrderId}/${currentItemId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        returnReason: returnReason === 'Other' ? otherReason : returnReason
                    })
                });

                const data = await response.json();

                if (data.success) {
                    Swal.fire('Success!', 'Return request submitted successfully.', 'success')
                        .then(() => window.location.reload());
                } else {
                    Swal.fire('Error!', data.error || 'Failed to submit return request.', 'error');
                }
            } catch (error) {
                Swal.fire('Error!', 'An unexpected error occurred.', 'error');
            }
        });
    }
});

    


   
