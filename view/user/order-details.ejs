
<head>
    <!-- Include Bootstrap CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">


</head>
<style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            background-color: #f4f4f4;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            background: #fff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        h1, h2 {
            color: #2c3e50;
        }
        .order-info {
            background-color: #ecf0f1;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
        }
        .order-status {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 15px;
            font-weight: bold;
        }
        .status-processing { background-color: #f39c12; color: #fff; }
        .status-shipped { background-color: #3498db; color: #fff; }
        .status-delivered { background-color: #2ecc71; color: #fff; }
        .status-cancelled { background-color: #e74c3c; color: #fff; }
        .tracking {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
        }
        .tracking-step {
            text-align: center;
            position: relative;
            flex: 1;
        }
        .tracking-step::before {
            content: '';
            position: absolute;
            top: 15px;
            left: -50%;
            right: 50%;
            height: 2px;
            background-color: #3498db;
            z-index: 1;
        }
        .tracking-step:first-child::before {
            display: none;
        }
        .tracking-icon {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background-color: #3498db;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 5px;
            position: relative;
            z-index: 2;
        }
        .tracking-icon.inactive {
            background-color: #bdc3c7;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        th, td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }
        th {
            background-color: #2c3e50;
            color: #fff;
        }
        .total-section {
            background-color: #ecf0f1;
            padding: 15px;
            border-radius: 5px;
            margin-top: 20px;
        }
        .total-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
        }
        .grand-total {
            font-weight: bold;
            font-size: 1.2em;
            color: #2c3e50;
        }
        .btn {
            display: inline-block;
            padding: 10px 20px;
            background-color: #e74c3c;
            color: #fff;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
            text-align: center;
        }
        .btn:hover {
            background-color: #c0392b;
        }
        @media (max-width: 600px) {
            .tracking {
                flex-direction: column;
            }
            .tracking-step {
                margin-bottom: 20px;
            }
            .tracking-step::before {
                display: none;
            }
            table, tr, td {
                display: block;
            }
            th {
                display: none;
            }
            tr {
                margin-bottom: 15px;
            }
            td {
                text-align: right;
                padding-left: 50%;
                position: relative;
            }
            td::before {
                content: attr(data-label);
                position: absolute;
                left: 6px;
                width: 45%;
                padding-right: 10px;
                white-space: nowrap;
                font-weight: bold;
                text-align: left;
            }
        }
        .order-status {
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.9em;
    font-weight: 500;
}

.status-delivered { background-color: #28a745; color: white; }
.status-cancelled { background-color: #dc3545; color: white; }
.status-pending { background-color: #ffc107; color: black; }
.status-processing { background-color: #17a2b8; color: white; }
.status-return { background-color: #6c757d; color: white; }
.status-returned { background-color: #6c757d; color: white; }

.total-section {
    margin-top: 20px;
    padding: 15px;
    border-top: 1px solid #dee2e6;
}

.total-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
}

.grand-total {
    font-weight: bold;
    font-size: 1.2em;
    border-top: 2px solid #dee2e6;
    padding-top: 10px;
}
    </style>



<div class="container">
    <h1>Order Details</h1>
    <div class="order-info">
        <p><strong>Order ID:</strong> <%= order._id %></p>
        <p class="order-date">Placed on: <%= new Date(order.createdOn).toLocaleDateString() %></p>
        <p><strong>Order Status:</strong>
            <span class="order-status status-<%= order.status.toLowerCase() %>">
                <% 
                let displayOrderStatus = order.status;
                if (order.status === 'payment_failed') {
                    displayOrderStatus = 'Pending';
                } else if (order.PaymentMethod === 'Online' && order.status === 'Processing') {
                    displayOrderStatus = 'Processing';
                }
                %>
                <%= displayOrderStatus %>
            </span>
        </p>
        <% if(order.PaymentMethod !== 'COD' && order.PaymentMethod !== 'Wallet'){%>
        <p><strong>Payment Status:</strong>
            <span class="order-status status-<%= order.status === 'payment_failed' ? 'cancelled' : 'delivered' %>">
                <%= order.status === 'payment_failed' ? 'Failed' : 'Paid' %>
            </span>
        </p>
        <%}%>


        <% if (order.status === 'payment_failed' && order.PaymentMethod === 'Online') { %>
            <div class="payment-failed-alert alert alert-warning" role="alert">
                <h4 class="alert-heading">Payment Failed!</h4>
                <p>Your payment was not successful. You can retry the payment using the button below.</p>
                <button id="retryPaymentBtn" class="btn btn-primary" data-order-id="<%= order._id %>">
                    Retry Payment
                </button>
            </div>
        <% } %>
    </div>

    <% if (order.status !== 'payment_failed') { %>
        <h2>Order Tracking</h2>
        <div class="tracking">
            <% 
            const trackingSteps = [
                { key: 'processing', label: 'Processing' },
                { key: 'shipped', label: 'Shipped' },
                { key: 'out_for_delivery', label: 'Out for Delivery' },
                { key: 'delivered', label: 'Delivered' }
            ];
            
            // Find the current step index based on order.status
            let currentStepIndex = -1;
            trackingSteps.forEach((step, index) => {
                if (step.key === order.status.toLowerCase()) {
                    currentStepIndex = index;
                }
            });
            %>
            
            <% trackingSteps.forEach((step, index) => { %>
                <div class="tracking-step">
                    <div class="tracking-icon <%= index > currentStepIndex ? 'inactive' : 'active' %>">
                        <%= index + 1 %>
                    </div>
                    <div class="step-label <%= index === currentStepIndex ? 'current' : '' %>">
                        <%= step.label %>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <h2>Payment Failed</h2>
        <p>There was an issue processing your payment. Please contact customer support.</p>
    <% } %>

    <% if (order.status !== 'payment_failed' && order.status !== 'cancelled') { %>
        <a href="/order/invoice/<%= order._id %>" class="btn btn-primary">
            Download Invoice
        </a>
    <% } %>

   <!-- Replace your existing order summary sections with this updated code -->
   <h2>Items Ordered</h2>
   <%
      const isOnlineOrWalletPayment = order.PaymentMethod === 'Online' || order.PaymentMethod === 'Wallet';
   
      const calculateOrderTotals = (order) => {
       const summary = {
           originalSubtotal: 0,
           currentSubtotal: 0,
           refundedAmount: 0,
           shippingCharge: order.shippingCharge || 50,
           isFullyReturnedOrCancelled: false,
           activeItems: 0,
           returnRequestItems: 0,
           couponDiscount: order.couponApplied ? (order.couponDetails.discountAmount || 0) : 0,
           currentTotal: 0,
           originalTotal: 0,
           couponMinPurchase: order.couponApplied ? (order.couponDetails.minPurchase || 0) : 0,
           isCouponStillValid: true
       };
   
       // Calculate original subtotal (sum of all items regardless of status)
       order.orderedItems.forEach(item => {
           const itemTotal = item.quantity * item.price;
           summary.originalSubtotal += itemTotal;
       });
   
       // Distribute the coupon discount proportionally across all items
       const discountRatio = summary.originalSubtotal > 0 ? summary.couponDiscount / summary.originalSubtotal : 0;
   
       // Process each item based on status
       order.orderedItems.forEach(item => {
           const itemTotal = item.quantity * item.price;
           const itemDiscount = itemTotal * discountRatio; // Proportional discount for the item
           const effectiveItemPrice = itemTotal - itemDiscount; // What customer actually paid for this item
           
           if (item.status === 'Return Request') {
               summary.returnRequestItems++;
               if (isOnlineOrWalletPayment) {
                   summary.refundedAmount += effectiveItemPrice;
               }
           } else if (item.status === 'cancelled' || item.status === 'Returned') {
               if (isOnlineOrWalletPayment) {
                   summary.refundedAmount += effectiveItemPrice;
               }
           } else {
               summary.activeItems++;
               summary.currentSubtotal += itemTotal; // Keep tracking original prices for active items
           }
       });
   
       // Check if order is fully returned/cancelled
       summary.isFullyReturnedOrCancelled = order.orderedItems.every(item => 
           ['cancelled', 'Returned', 'Return Request'].includes(item.status)
       );
   
       // Check if remaining items still meet the minimum purchase requirement for the coupon
       summary.isCouponStillValid = summary.currentSubtotal >= summary.couponMinPurchase;
   
       // Calculate active coupon discount (only if valid)
       let activeCouponDiscount = 0;
       if (summary.isCouponStillValid) {
           activeCouponDiscount = summary.currentSubtotal > 0 ? 
               (summary.currentSubtotal / summary.originalSubtotal) * summary.couponDiscount : 0;
       }
   
       // Calculate original total (what customer actually paid)
       summary.originalTotal = summary.originalSubtotal - summary.couponDiscount + summary.shippingCharge;
       
       // Calculate current total based on active items
       if (summary.isFullyReturnedOrCancelled) {
           summary.currentTotal = 0;
           // Refund everything including shipping for online/wallet payments
           if (isOnlineOrWalletPayment) {
               summary.refundedAmount = summary.originalTotal;
           }
       } else {
           // Current total with or without coupon based on minimum purchase
           summary.currentTotal = summary.currentSubtotal - (summary.isCouponStillValid ? activeCouponDiscount : 0) + summary.shippingCharge;
           
           // If coupon is no longer valid, add the already discounted amount to refund
           if (!summary.isCouponStillValid && isOnlineOrWalletPayment) {
               // Calculate the portion of coupon discount applied to active items
               const activeItemsOriginalDiscount = (summary.currentSubtotal / summary.originalSubtotal) * summary.couponDiscount;
               
               // Add this to refunded amount since customer now needs to pay full price for active items
               summary.refundedAmount -= activeItemsOriginalDiscount;
           }
       }
   
       // If there's only one item left active, check if cancelling it would require shipping refund
       if (summary.activeItems === 1 && order.orderedItems.length > 1) {
           // Store the shipping refund info for the UI
           summary.willRefundShippingIfLastItemCancelled = true;
       }
   
       return summary;
      };
   
      const totals = calculateOrderTotals(order);
      const showRefund = isOnlineOrWalletPayment;
   %>
      
   <table>
       <thead>
           <tr>
               <th>Product</th>
               <th>Image</th>
               <th>Quantity</th>
               <th>Price</th>
               <th>Total</th>
               <th>Status</th>
               <th>Actions</th>
           </tr>
       </thead>
      
       <tbody>
           <% order.orderedItems.forEach(item => { 
               const itemTotal = item.quantity * item.price;
               const isCancelledOrReturned = item.status === 'cancelled' || item.status === 'Returned' || item.status === 'Return Request';
               const isPendingReturn = item.status === 'Return Request';


               // Calculate the effective price with coupon discount
               const discountRatio = totals.originalSubtotal > 0 ? 
                   (order.couponApplied ? order.couponDetails.discountAmount : 0) / totals.originalSubtotal : 0;
               const effectiveItemPrice = itemTotal - (itemTotal * discountRatio);
           %>
               <tr class="<%= isCancelledOrReturned ? 'cancelled-item' : (isPendingReturn ? 'pending-return-item' : '') %>">
                   <td data-label="Product"><%= item.product.productName %></td>
                   <td>
                       <img src="/uploads/<%= item.product.productImage[0] %>" 
                           alt="<%= item.product.productName %>"
                           class="img-fluid rounded-circle"
                           style="width: 40px; height: 40px;">
                   </td>
                   <td data-label="Quantity"><%= item.quantity %></td>
                   <td data-label="Price">₹<%= item.price.toFixed(2) %></td>
                   <td data-label="Total">
                       <% if (isCancelledOrReturned && showRefund) { %>
                           <s>₹<%= itemTotal.toFixed(2) %></s>
                           <div class="refund-details">
                               <span class="text-muted">(Refunded: ₹<%= effectiveItemPrice.toFixed(2) %>)</span>
                           </div>
                           <% } else if (isPendingReturn) { %>
                            <s>₹<%= itemTotal.toFixed(2) %></s>
                            <div class="return-pending-details">
                                <span class="text-warning">(Return pending approval)</span>
                            </div>
                       <% } else { %>
                           ₹<%= itemTotal.toFixed(2) %>
                       <% } %>
                   </td>
                   <td data-label="Status">
                       <% if (order.status === 'Returned' && item.status === 'Return Request') { %>
                           <span class="badge bg-success">Returned</span>
                       <% } else { %>
                        <span class="badge bg-<%= 
                        item.status === 'delivered' ? 'success' : 
                        item.status === 'Returned' ? 'info' : 
                        item.status === 'Return Request' ? 'warning' : 
                        item.status === 'cancelled' ? 'danger' : 
                        'secondary' 
                    %>"><%= item.status %></span>
                       <% } %>
                   </td>
                   
                   <td data-label="Actions">
                       <% if ((item.status === 'pending' || item.status === 'processing') && 
                           order.status !== 'cancelled') { %>
                           <button class="btn btn-danger btn-sm cancel-item-btn" 
                               data-order-id="<%= order._id %>" 
                               data-item-id="<%= item._id %>"
                               <% if (totals.activeItems === 1 && !isCancelledOrReturned && !isPendingReturn) { %>
                                   data-is-last-item="true"
                                   title="Cancelling this item will cancel the entire order and refund shipping"
                               <% } %>>
                               Cancel Item
                           </button>
                       <% } %>
                       
                       <% 
                       let showReturnButton = false;
                       if (item.status === 'delivered' && 
                           !['Return Request', 'Returned', 'cancelled'].includes(item.status)) {
                           
                           const deliveredDate = order.deliveredDate ? new Date(order.deliveredDate) : null;
                           const currentDate = new Date();
                           
                           if (deliveredDate instanceof Date && !isNaN(deliveredDate)) {
                               const daysSinceDelivery = Math.floor((currentDate - deliveredDate) / (1000 * 60 * 60 * 24));
                               showReturnButton = daysSinceDelivery <= 7;
                           } else {
                               console.log(`Invalid deliveredDate for order ${order._id}: ${order.deliveredDate}`);
                           }
                       }
                       %>
                       
                       <% if (showReturnButton) { %>
                           <button class="btn btn-warning btn-sm return-item-btn" 
                               data-order-id="<%= order._id %>" 
                               data-item-id="<%= item._id %>"
                               <% if (totals.activeItems === 1 && !isCancelledOrReturned && !isPendingReturn) { %>
                                   data-is-last-item="true"
                                   title="Returning this item will return the entire order and refund shipping"
                               <% } %>>
                               Return Item
                           </button>
                       <% } %>
                       
                       <% if (item.status === 'Return Request') { %>
                           <span class="badge bg-warning">Return Pending</span>
                       <% } %>
                   </td>
               </tr>
           <% }); %>
       </tbody>
   </table>
   
   <!-- Enhanced Order Summary Section -->
   <div class="total-section">
    <div class="total-row">
        <span>Original Subtotal:</span>
        <span>₹<%= totals.originalSubtotal.toFixed(2) %></span>
    </div>
    
    <% if (order.couponApplied && order.couponDetails) { %>
        <div class="total-row discount">
            <span>Coupon Applied (<%= order.couponDetails.couponName %>):</span>
            <span>-₹<%= (order.couponDetails.discountAmount || 0).toFixed(2) %></span>
            
            <% if (totals.couponMinPurchase > 0) { %>
                <div class="coupon-details">
                    <small>(Min. purchase: ₹<%= totals.couponMinPurchase.toFixed(2) %>)</small>
                </div>
            <% } %>
        </div>
        
        <% if (!totals.isFullyReturnedOrCancelled && !totals.isCouponStillValid && totals.currentSubtotal > 0) { %>
            <div class="total-row coupon-invalid">
                <span>Coupon no longer valid:</span>
                <span>+₹<%= ((totals.currentSubtotal / totals.originalSubtotal) * totals.couponDiscount).toFixed(2) %></span>
                <div class="coupon-details">
                    <small>(Current subtotal ₹<%= totals.currentSubtotal.toFixed(2) %> below minimum ₹<%= totals.couponMinPurchase.toFixed(2) %>)</small>
                </div>
            </div>
        <% } %>
    <% } %>
    
    <div class="total-row">
        <span>Shipping Charge:</span>
        <% if (totals.shippingRefunded && isOnlineOrWalletPayment) { %>
            <span><s>₹<%= totals.shippingCharge.toFixed(2) %></s> <span class="text-success">(Refunded)</span></span>
        <% } else { %>
            <span>₹<%= totals.shippingCharge.toFixed(2) %></span>
        <% } %>
    </div>
    
    <div class="total-row grand-total">
        <span>Original Amount Paid:</span>
        <span>₹<%= order.finalAmount.toFixed(2) %></span>
    </div>
    
    <% if (totals.refundedAmount > 0 && isOnlineOrWalletPayment) { %>
        <div class="total-row text-success refunded-amount">
            <span>Refunded Amount:</span>
            <span>₹<%= totals.refundedAmount.toFixed(2) %></span>
            
            <% if (totals.shippingRefunded) { %>
                <div class="refund-details">
                    <small>(Includes shipping charge of ₹<%= totals.shippingCharge.toFixed(2) %>)</small>
                </div>
            <% } %>
        </div>
        
        <% if (!totals.isFullyReturnedOrCancelled) { %>
            <div class="total-row current-total">
                <span>Current Order Total:</span>
                <span>₹<%= totals.currentTotal.toFixed(2) %></span>
            </div>
        <% } %>
    <% } %>
    
    <% if (totals.returnRequestItems > 0 && isOnlineOrWalletPayment) { %>
        <div class="info-row">
            <i class="fas fa-info-circle"></i>
            <span>Return request(s) pending approval. Refund will be processed after approval.</span>
        </div>
    <% } %>
    
   
    
    <% if (totals.isFullyReturnedOrCancelled) { %>
        <div class="total-row text-<%= totals.returnRequestItems > 0 ? 'warning' : 'danger' %> order-status">
            <span>Order Status:</span>
            <span><%= order.status.toUpperCase() %></span>
        </div>
    <% } %>
</div>
   
    <h2>Shipping Address</h2>
    <p>
        <strong>Name:</strong> <%= order.address.name %><br>
        <strong>Street:</strong> <%= order.address.street %><br>
        <strong>City:</strong> <%= order.address.city %><br>
        <strong>State & Pin:</strong> <%= order.address.state %> - <%= order.address.zipCode %><br>
        <strong>Phone:</strong> <%= order.address.phone %>
    </p>

   

    <div>
        <% if (order.status === 'cancelled') { %>
            <div class="order-cancelled-message">
                <h2>Order Cancelled</h2>
                <p>Your order has been successfully cancelled.</p>
                <a href="/" class="btn">OK</a>
            </div>
        <% } else if (order.status === 'delivered') { %>
            <button class="btn return-btn" data-order-id="<%= order._id %>">Return Order</button>
    
            <!-- Return Reason Modal -->
            <div class="modal fade" id="returnReasonModal" tabindex="-1" aria-labelledby="returnReasonModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="returnReasonModalLabel">Return Order</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form id="returnReasonForm">
                                <div class="mb-3">
                                    <label for="returnReason" class="form-label">Reason for Return</label>
                                    <select class="form-select" id="returnReason" required>
                                        <option value="">Select a reason</option>
                                        <option value="Wrong Size">Wrong Size</option>
                                        <option value="Damaged Product">Damaged Product</option>
                                        <option value="Not as Described">Not as Described</option>
                                        <option value="Changed Mind">Changed Mind</option>
                                        <option value="Quality Issue">Quality Issue</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                                <div id="otherReasonContainer" style="display:none;">
                                    <label for="otherReason" class="form-label">Please specify your reason</label>
                                    <textarea class="form-control" id="otherReason" rows="3"></textarea>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-primary" id="submitReturnBtn">Submit Return Request</button>
                        </div>
                    </div>
                </div>
            </div>
        <% } else if (order.status !== 'delivered') { %>
            <button class="btn cancel-btn" data-order-id="<%= order._id %>">Cancel Order</button>
        <% } %>
    </div>

    <div class="modal fade" id="returnItemModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Return Item</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="returnItemForm">
                        <div class="mb-3">
                            <label for="itemReturnReason" class="form-label">Reason for Return</label>
                            <select class="form-select" id="itemReturnReason" required>
                                <option value="">Select a reason</option>
                                <option value="Wrong Size">Wrong Size</option>
                                <option value="Damaged Product">Damaged Product</option>
                                <option value="Not as Described">Not as Described</option>
                                <option value="Changed Mind">Changed Mind</option>
                                <option value="Quality Issue">Quality Issue</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div id="otherItemReasonContainer" style="display:none;">
                            <label for="otherItemReason" class="form-label">Please specify</label>
                            <textarea class="form-control" id="otherItemReason" rows="3"></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="submitItemReturnBtn">Submit</button>
                </div>
            </div>
        </div>
    </div>

</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <!-- Add JavaScript for handling item actions -->
    <script>


   

    document.addEventListener('DOMContentLoaded', function() {
        // Handle Cancel Item
        document.querySelectorAll('.cancel-item-btn').forEach(button => {
            button.addEventListener('click', async function() {
                const orderId = this.getAttribute('data-order-id');
                const itemId = this.getAttribute('data-item-id');
                
                const result = await Swal.fire({
                    title: 'Cancel Item?',
                    text: 'Are you sure you want to cancel this item?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, cancel it',
                    cancelButtonText: 'No, keep it'
                });
    
                if (result.isConfirmed) {
                    try {
