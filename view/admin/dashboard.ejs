<%- include("../../view/partials/admin/header") %>

<head>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    </head>

    <div class="container-fluid px-4 mt-4">
      <h1 class="h3 mb-4">Admin Dashboard</h1>
      
      <!-- Filter Controls -->
      <div class="card mb-4">
        <div class="card-header">
          <i class="fas fa-filter"></i> Filter Data
        </div>
        <div class="card-body">
          <div class="row align-items-end">
            <div class="col-md-3 mb-3">
              <label for="timeFilter" class="form-label">Time Period</label>
              <select class="form-select" id="timeFilter">
                <option value="daily">Daily</option>
                <option value="weekly">Weekly</option>
                <option value="monthly" selected>Monthly</option>
                <option value="yearly">Yearly</option>
                <option value="custom">Custom Range</option>
              </select>
            </div>
            
            <div class="col-md-3 mb-3 custom-date-range" style="display: none;">
              <label for="startDate" class="form-label">Start Date</label>
              <input type="date" class="form-control" id="startDate">
            </div>
            
            <div class="col-md-3 mb-3 custom-date-range" style="display: none;">
              <label for="endDate" class="form-label">End Date</label>
              <input type="date" class="form-control" id="endDate">
            </div>
            
            <div class="col-md-3 mb-3">
              <button class="btn btn-primary w-100" id="applyFilter">Apply Filter</button>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Stats Summary Cards -->
      <div class="row mb-4">
        <div class="col-md-6">
          <div class="card bg-primary text-white h-100">
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
              <h2 class="display-4" id="totalRevenue">₹0</h2>
              <p class="text-white-50">Total Revenue</p>
            </div>
          </div>
        </div>
        
        <div class="col-md-6">
          <div class="card bg-success text-white h-100">
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
              <h2 class="display-4" id="orderCount">0</h2>
              <p class="text-white-50">Orders</p>
            </div>
          </div>
        </div>

          <!-- Order Status Cards -->
          
          <div class="card mb-4">
            <div class="card-header">
              <i class="fas fa-tasks"></i> Order Status Summary
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-12 mb-3">
                  <div class="card bg-dark text-white">
                    <div class="card-body">
                      <h3 id="totalCount">0</h3>
                      <p class="mb-0">Total Orders</p>
                      <div class="d-flex flex-wrap mt-3">
                        <div class="me-3 mb-2">
                          <span class="badge bg-info p-2">Pending: <span id="pendingCount">0</span></span>
                        </div>
                        <div class="me-3 mb-2">
                          <span class="badge bg-warning p-2">Processing: <span id="processingCount">0</span></span>
                        </div>
                        <div class="me-3 mb-2">
                          <span class="badge bg-danger p-2">Cancelled: <span id="cancelledCount">0</span></span>
                        </div>
                        <div class="me-3 mb-2">
                          <span class="badge bg-secondary p-2">Returned: <span id="returnedCount">0</span></span>
                        </div>
                        <div class="me-3 mb-2">
                          <span class="badge bg-success p-2">Delivered: <span id="deliveredCount">0</span></span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
      </div>
      
      <!-- Sales Over Time Chart -->
      <div class="card mb-4">
        <div class="card-header">
          <i class="fas fa-chart-line"></i> Sales Over Time
        </div>
        <div class="card-body">
          <canvas id="salesOverTimeChart" height="200"></canvas>
        </div>
      </div>
      
      <!-- Top Products, Categories, and Brands -->
      <div class="row mb-4">
        <!-- Top Products -->
        <div class="col-lg-4 mb-4">
          <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
              <span><i class="fas fa-box"></i> Top 10 Products</span>
              <button class="btn btn-sm btn-outline-secondary" data-chart-toggle="productsChart">
                <i class="fas fa-chart-pie"></i>
              </button>
            </div>
            <div class="card-body">
              <div class="chart-container mb-3" style="height: 300px; display: none;">
                <canvas id="productsChart"></canvas>
              </div>
              <div class="table-responsive" id="productsTable">
                <table class="table table-sm table-striped">
                  <thead>
                    <tr>
                      <th>Product</th>
                      <th>Qty Sold</th>
                      <th>Revenue</th>
                    </tr>
                  </thead>
                  <tbody id="topProductsTableBody">
                    <tr>
                      <td colspan="3" class="text-center">Loading data...</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Top Categories -->
        <div class="col-lg-4 mb-4">
          <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
              <span><i class="fas fa-tags"></i> Top 10 Categories</span>
              <button class="btn btn-sm btn-outline-secondary" data-chart-toggle="categoriesChart">
                <i class="fas fa-chart-pie"></i>
              </button>
            </div>
            <div class="card-body">
              <div class="chart-container mb-3" style="height: 300px; display: none;">
                <canvas id="categoriesChart"></canvas>
              </div>
              <div class="table-responsive" id="categoriesTable">
                <table class="table table-sm table-striped">
                  <thead>
                    <tr>
                      <th>Category</th>
                      <th>Qty Sold</th>
                      <th>Revenue</th>
                    </tr>
                  </thead>
                  <tbody id="topCategoriesTableBody">
                    <tr>
                      <td colspan="3" class="text-center">Loading data...</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Top Brands -->
        <div class="col-lg-4 mb-4">
          <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
              <span><i class="fas fa-crown"></i> Top 10 Brands</span>
              <button class="btn btn-sm btn-outline-secondary" data-chart-toggle="brandsChart">
                <i class="fas fa-chart-pie"></i>
              </button>
            </div>
            <div class="card-body">
              <div class="chart-container mb-3" style="height: 300px; display: none;">
                <canvas id="brandsChart"></canvas>
              </div>
              <div class="table-responsive" id="brandsTable">
                <table class="table table-sm table-striped">
                  <thead>
                    <tr>
                      <th>Brand</th>
                      <th>Qty Sold</th>
                      <th>Revenue</th>
                    </tr>
                  </thead>
                  <tbody id="topBrandsTableBody">
                    <tr>
                      <td colspan="3" class="text-center">Loading data...</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Include Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.7.0/dist/chart.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"></script>
    
    <!-- Dashboard JavaScript -->
    <script>


// Dashboard JavaScript
document.addEventListener('DOMContentLoaded', function() {
  // Initialize charts
  let salesChart, productsChart, categoriesChart, brandsChart;
  
  // Default filter
  let currentFilter = 'monthly';
  let customStartDate = null;
  let customEndDate = null;
  
  // Chart colors
  const chartColors = [
    'rgba(54, 162, 235, 0.8)',
    'rgba(255, 99, 132, 0.8)',
    'rgba(255, 206, 86, 0.8)',
    'rgba(75, 192, 192, 0.8)',
    'rgba(153, 102, 255, 0.8)',
    'rgba(255, 159, 64, 0.8)',
    'rgba(199, 199, 199, 0.8)',
    'rgba(83, 102, 255, 0.8)',
    'rgba(40, 159, 64, 0.8)',
    'rgba(210, 199, 199, 0.8)',
  ];
  
  // Show/hide custom date range inputs
  document.getElementById('timeFilter').addEventListener('change', function() {
    const customDateFields = document.querySelectorAll('.custom-date-range');
    if (this.value === 'custom') {
      customDateFields.forEach(field => field.style.display = 'block');
    } else {
      customDateFields.forEach(field => field.style.display = 'none');
    }
  });
  
  // Apply filter button
  document.getElementById('applyFilter').addEventListener('click', function() {
    currentFilter = document.getElementById('timeFilter').value;
    
    if (currentFilter === 'custom') {
      customStartDate = document.getElementById('startDate').value;
      customEndDate = document.getElementById('endDate').value;
      
      if (!customStartDate || !customEndDate) {
        alert('Please select both start and end dates');
        return;
      }
    }
    
    fetchDashboardData();
  });
  
  // Toggle between chart and table views
  document.querySelectorAll('[data-chart-toggle]').forEach(button => {
    button.addEventListener('click', function() {
      const chartId = this.getAttribute('data-chart-toggle');
      const chartContainer = document.querySelector(`#${chartId}`).parentElement;
      const tableId = chartId.replace('Chart', 'Table');
      const tableContainer = document.getElementById(tableId);
      
      if (chartContainer.style.display === 'none') {
        chartContainer.style.display = 'block';
        tableContainer.style.display = 'none';
        this.innerHTML = '<i class="fas fa-table"></i>';
      } else {
        chartContainer.style.display = 'none';
        tableContainer.style.display = 'block';
        this.innerHTML = '<i class="fas fa-chart-pie"></i>';
      }
    });
  });
  
  // Format currency
  function formatCurrency(amount) {
    return '₹' + parseInt(amount).toLocaleString('en-IN');
  }
  
  // Fetch dashboard data
  function fetchDashboardData() {
    let url = `/admin/dashboard/data?filter=${currentFilter}`;
    
    if (currentFilter === 'custom') {
      url += `&customStartDate=${customStartDate}&customEndDate=${customEndDate}`;
    }
    
    fetch(url)
      .then(response => response.json())
      .then(data => {
        updateDashboardData(data);
      })
      .catch(error => {
        console.error('Error fetching dashboard data:', error);
      });
  }
  


// Add this to your updateDashboardData function
function updateDashboardData(data) {
    // Update summary stats
    document.getElementById('totalRevenue').textContent = formatCurrency(data.salesSummary.totalRevenue || 0);
    document.getElementById('orderCount').textContent = data.salesSummary.orderCount || 0;
    
    // Update order status counts
    const orderStatusCounts = data.orderStatusCounts || {};
    document.getElementById('pendingCount').textContent = orderStatusCounts.pending || 0;
    document.getElementById('processingCount').textContent = orderStatusCounts.processing || 0;
    document.getElementById('cancelledCount').textContent = orderStatusCounts.cancelled || 0;
    document.getElementById('returnedCount').textContent = orderStatusCounts.returned || 0;
    document.getElementById('deliveredCount').textContent = orderStatusCounts.delivered || 0;
    
    // Calculate total orders across all statuses
    const totalOrders = Object.values(orderStatusCounts).reduce((sum, count) => sum + count, 0);
    document.getElementById('totalCount').textContent = totalOrders;
    
    // Update sales over time chart
    updateSalesChart(data.salesOverTime);
    
    // Update top products
    updateTopProducts(data.topProducts);
    
    // Update top categories
    updateTopCategories(data.topCategories);
    
    // Update top brands
    updateTopBrands(data.topBrands);
}

  

// Improved updateSalesChart function
function updateSalesChart(salesData) {
    const chartContainer = document.getElementById('salesOverTimeChart').parentElement;
    
   
    
    // Restore canvas if it was replaced
    if (!document.getElementById('salesOverTimeChart')) {
        chartContainer.innerHTML = '<canvas id="salesOverTimeChart" height="200"></canvas>';
    }
    
    const ctx = document.getElementById('salesOverTimeChart').getContext('2d');
    const labels = salesData.map(item => item._id);
    const revenues = salesData.map(item => item.revenue);
    
    if (salesChart) {
        salesChart.destroy();
    }
    
    salesChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'Revenue',
                data: revenues,
                borderColor: 'rgba(54, 162, 235, 1)',
                backgroundColor: 'rgba(54, 162, 235, 0.1)',
                tension: 0.4,
                fill: true
            }]
        },
        options: {
            responsive: true,
            plugins: {
                title: {
                    display: true,
                    text: 'Sales Revenue Over Time'
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return formatCurrency(context.raw);
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return formatCurrency(value);
                        }
                    }
                }
            }
        }
    });
}

  // Update top products chart and table
  function updateTopProducts(products) {
    // Update table
    const tableBody = document.getElementById('topProductsTableBody');
    tableBody.innerHTML = '';
    
    if (products.length === 0) {
      tableBody.innerHTML = '<tr><td colspan="3" class="text-center">No data available</td></tr>';
      return;
    }
    
    products.forEach(product => {
      const row = document.createElement('tr');
      row.innerHTML = `
        <td>${product.productName}</td>
        <td>${product.totalQuantity}</td>
        <td>${formatCurrency(product.totalRevenue)}</td>
      `;
      tableBody.appendChild(row);
    });
    
    // Update chart
    const ctx = document.getElementById('productsChart').getContext('2d');
    
    const labels = products.map(item => item.productName);
    const quantities = products.map(item => item.totalQuantity);
    
    if (productsChart) {
      productsChart.destroy();
    }
    
    productsChart = new Chart(ctx, {
      type: 'pie',
      data: {
        labels: labels,
        datasets: [{
          label: 'Quantity Sold',
          data: quantities,
          backgroundColor: chartColors,
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: {
            position: 'right',
            labels: {
              boxWidth: 12
            }
          },
          title: {
            display: true,
            text: 'Top Products by Quantity Sold'
          }
        }
      }
    });
  }
  
  // Update top categories chart and table
  function updateTopCategories(categories) {
    // Update table
    const tableBody = document.getElementById('topCategoriesTableBody');
    tableBody.innerHTML = '';
    
    if (categories.length === 0) {
      tableBody.innerHTML = '<tr><td colspan="3" class="text-center">No data available</td></tr>';
      return;
    }
    
    categories.forEach(category => {
      const row = document.createElement('tr');
      row.innerHTML = `
        <td>${category.categoryName}</td>
        <td>${category.totalQuantity}</td>
        <td>${formatCurrency(category.totalRevenue)}</td>
      `;
      tableBody.appendChild(row);
    });
    
    // Update chart
    const ctx = document.getElementById('categoriesChart').getContext('2d');
    
    const labels = categories.map(item => item.categoryName);
    const quantities = categories.map(item => item.totalQuantity);
    
    if (categoriesChart) {
      categoriesChart.destroy();
    }
    
    categoriesChart = new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: labels,
        datasets: [{
          label: 'Quantity Sold',
          data: quantities,
          backgroundColor: chartColors,
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: {
            position: 'right',
            labels: {
              boxWidth: 12
            }
          },
          title: {
            display: true,
            text: 'Top Categories by Quantity Sold'
          }
        }
      }
    });
  }
  
  // Update top brands chart and table
  function updateTopBrands(brands) {
    // Update table
    const tableBody = document.getElementById('topBrandsTableBody');
    tableBody.innerHTML = '';
    
    if (brands.length === 0) {
      tableBody.innerHTML = '<tr><td colspan="3" class="text-center">No data available</td></tr>';
      return;
    }
    
    brands.forEach(brand => {
      const row = document.createElement('tr');
      row.innerHTML = `
        <td>${brand.brandName}</td>
        <td>${brand.totalQuantity}</td>
        <td>${formatCurrency(brand.totalRevenue)}</td>
      `;
      tableBody.appendChild(row);
    });
    
    // Update chart
    const ctx = document.getElementById('brandsChart').getContext('2d');
    
    const labels = brands.map(item => item.brandName);
    const quantities = brands.map(item => item.totalQuantity);
    
    if (brandsChart) {
      brandsChart.destroy();
    }
    
    brandsChart = new Chart(ctx, {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [{
          label: 'Quantity Sold',
          data: quantities,
          backgroundColor: chartColors,
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        indexAxis: 'y',
        plugins: {
          legend: {
            display: false
          },
          title: {
            display: true,
            text: 'Top Brands by Quantity Sold'
          }
        }
      }
    });
  }
  
  // Initial data load
  fetchDashboardData();
});
    </script>
    

<%- include("../../view/partials/admin/footer") %>
